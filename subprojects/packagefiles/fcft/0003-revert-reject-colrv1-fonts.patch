-        uint16_t version;
-        FT_ULong length = sizeof(version);
-
-        if ((ft_err = FT_Load_Sfnt_Table(ft_face, TTAG_COLR, 0, (FT_Byte *)&version, &length)) != FT_Err_Ok) {
