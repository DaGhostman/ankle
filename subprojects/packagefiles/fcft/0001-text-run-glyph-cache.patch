     struct fcft_font_options options;
     size_t ref_counter;
 };
@@ -2579,12 +2587,98 @@ struct text_run {
     size_t size;
 };
 
+/* Must be a power of two */
+#define RUN_GLYPH_CACHE_SIZE 1024
+
+struct run_glyph {
+    struct run_glyph *next;
+    const struct instance *inst;
+    uint32_t index;
+    enum fcft_subpixel subpixel;
+    struct glyph_priv *glyph;  /* NULL if rasterization failed */
+};
+
+/*
+ * Returns the (cached) glyph for glyph index 'index' in 'inst'. Must
+ * be called with font->lock held.
+ */
+static const struct glyph_priv *
+run_glyph_cache_get(struct font_priv *font, const struct instance *inst,
+                    uint32_t index, enum fcft_subpixel subpixel)
+{
+    if (font->run_glyph_cache == NULL) {
+        font->run_glyph_cache = calloc(
+            RUN_GLYPH_CACHE_SIZE, sizeof(font->run_glyph_cache[0]));
+        if (font->run_glyph_cache == NULL)
+            return NULL;
+    }
+
+    size_t idx = hash_index_for_size(
+        RUN_GLYPH_CACHE_SIZE,
+        ((uintptr_t)inst >> 4) ^ (size_t)subpixel << 29 ^ index);
+
+    for (const struct run_glyph *e = font->run_glyph_cache[idx];
+         e != NULL;
+         e = e->next)
+    {
+        if (e->inst == inst && e->index == index && e->subpixel == subpixel)
+            return e->glyph;
+    }
+
+    struct glyph_priv *glyph = malloc(sizeof(*glyph));
+    if (glyph == NULL)
+        return NULL;
+
+    if (!glyph_for_index(inst, index, subpixel, &font->options, glyph)) {
+        free(glyph);
+        glyph = NULL;
+    }
+
+    struct run_glyph *e = malloc(sizeof(*e));
+    if (e == NULL) {
+        if (glyph != NULL)
+            glyph_destroy_private(glyph);
+        return NULL;
+    }
+
+    *e = (struct run_glyph){
+        .next = font->run_glyph_cache[idx],
+        .inst = inst,
+        .index = index,
+        .subpixel = subpixel,
+        .glyph = glyph,
+    };
+    font->run_glyph_cache[idx] = e;
+    return glyph;
+}
+
+static void
+run_glyph_cache_destroy(struct font_priv *font)
+{
+    if (font->run_glyph_cache == NULL)
+        return;
+
+    for (size_t i = 0; i < RUN_GLYPH_CACHE_SIZE; i++) {
+        struct run_glyph *e = font->run_glyph_cache[i];
+        while (e != NULL) {
+            struct run_glyph *next = e->next;
+            if (e->glyph != NULL)
+                glyph_destroy_private(e->glyph);
+            free(e);
+            e = next;
+        }
+    }
+
+    free(font->run_glyph_cache);
+    font->run_glyph_cache = NULL;
+}
