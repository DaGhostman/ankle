--- a/fcft.c
+++ b/fcft.c
@@ -158,6 +158,14 @@ struct font_priv {
 
     tll(struct fallback) fallbacks;
 
+#if defined(FCFT_HAVE_HARFBUZZ) && defined(FCFT_HAVE_UTF8PROC)
+    /*
+     * Glyphs rasterized by text-runs, keyed on font instance and
+     * glyph index (not codepoint). Protected by 'lock'.
+     */
+    struct run_glyph **run_glyph_cache;
+#endif
