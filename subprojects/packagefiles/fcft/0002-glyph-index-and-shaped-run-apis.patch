From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: barsmonster <3@14.by>
Date: Sat, 21 Feb 2026 11:52:52 +0000
Subject: [PATCH 1/3] Add glyph-index and shaped-run rasterization APIs

Add fcft_rasterize_glyph_index() for rasterizing by
FreeType glyph index with caching, and
fcft_rasterize_shaped_run() which shapes a codepoint
array with HarfBuzz and returns individually-cached
glyphs per input position. Falls back to
fcft_rasterize_char_utf32 for characters missing from
the primary font.
---
 fcft.c      | 170 +++++++++++++++++++++++++++++++++++++++++++++++++++-
 fcft/fcft.h |  19 ++++++
 2 files changed, 188 insertions(+), 1 deletion(-)

diff --git a/fcft.c b/fcft.c
index 4cd4ba6..48b3f37 100644
--- a/fcft.c
+++ b/fcft.c
@@ -1539,7 +1539,8 @@ glyph_for_index(const struct instance *inst, uint32_t index,
     int stride = stride_for_format_and_width(pix_format, width);
     assert(stride >= bitmap->pitch);
 
-    assert(bitmap->buffer != NULL || rows * stride == 0);
+    if (bitmap->buffer == NULL && rows * stride != 0)
+        goto err;
     data = malloc(rows * stride);
     if (data == NULL)
         goto err;
@@ -2164,8 +2165,165 @@ search_fonts:
     return got_glyph ? &glyph->public : NULL;
 }
 
+FCFT_EXPORT const struct fcft_glyph *
+fcft_rasterize_glyph_index(struct fcft_font *_font,
+                           uint32_t glyph_index,
+                           enum fcft_subpixel subpixel)
+{
+    struct font_priv *font = (struct font_priv *)_font;
+
+    /*
+     * Use the existing glyph cache with a sentinel
+     * high bit so glyph-ID keys never collide with
+     * codepoint keys (max codepoint is 0x10FFFF).
+     */
+    const uint32_t key = 0x80000000u | glyph_index;
+
+    pthread_rwlock_rdlock(&font->glyph_cache_lock);
+    struct glyph_priv **entry =
+        glyph_cache_lookup(font, key, subpixel);
+
+    if (*entry != NULL) {
+        const struct glyph_priv *glyph = *entry;
+        pthread_rwlock_unlock(
+            &font->glyph_cache_lock);
+        return glyph->valid
+            ? &glyph->public : NULL;
+    }
+
+    pthread_rwlock_unlock(&font->glyph_cache_lock);
+    mtx_lock(&font->lock);
+
+    /* Double-check after acquiring mutex */
+    entry = glyph_cache_lookup(
+        font, key, subpixel);
+    if (*entry != NULL) {
+        const struct glyph_priv *glyph = *entry;
+        mtx_unlock(&font->lock);
+        return glyph->valid
+            ? &glyph->public : NULL;
+    }
+
+    if (glyph_cache_resize(font))
+        entry = glyph_cache_lookup(
+            font, key, subpixel);
+
+    struct glyph_priv *glyph =
+        malloc(sizeof(*glyph));
+    if (glyph == NULL) {
+        mtx_unlock(&font->lock);
+        return NULL;
+    }
+
+    glyph->public.cp = key;
+    glyph->valid = false;
+
+    assert(tll_length(font->fallbacks) > 0);
+    struct instance *inst =
+        tll_front(font->fallbacks).font;
+    assert(inst != NULL);
+
+    bool got_glyph = glyph_for_index(
+        inst, glyph_index, subpixel,
+        &font->options, glyph);
+
+    glyph->public.cp = key;
+    glyph->public.cols = 1;
+
+    assert(*entry == NULL);
+    *entry = glyph;
+    font->glyph_cache.count++;
+
+    mtx_unlock(&font->lock);
+    return got_glyph ? &glyph->public : NULL;
+}
+
 #if defined(FCFT_HAVE_HARFBUZZ)
 
+FCFT_EXPORT size_t
+fcft_rasterize_shaped_run(
+    struct fcft_font *_font,
+    size_t len, const uint32_t text[static len],
+    enum fcft_subpixel subpixel,
+    const struct fcft_glyph *out[static len])
+{
+    struct font_priv *font =
+        (struct font_priv *)_font;
+
+    assert(tll_length(font->fallbacks) > 0);
+    struct instance *inst =
+        tll_front(font->fallbacks).font;
+    if (inst == NULL || inst->hb_font == NULL)
+        return 0;
+
+    /* Shape with HarfBuzz.  Use a per-call buffer since this may be
+     * called from multiple render threads concurrently.  Hold
+     * font->lock around hb_shape: the hb-ft backend calls
+     * FT_Load_Glyph on inst->face for glyph metrics during shaping,
+     * which races with other threads that call FT_Load_Glyph /
+     * FT_Render_Glyph under the same lock. */
+    hb_buffer_t *buf = hb_buffer_create();
+    hb_buffer_add_utf32(
+        buf, text, len, 0, len);
+    hb_buffer_set_direction(
+        buf, HB_DIRECTION_LTR);
+    hb_buffer_set_script(
+        buf, HB_SCRIPT_COMMON);
+    mtx_lock(&font->lock);
+    hb_shape(inst->hb_font, buf,
+             inst->hb_feats,
+             inst->hb_feats_count);
+    mtx_unlock(&font->lock);
+
+    unsigned cnt;
+    hb_glyph_info_t *info =
+        hb_buffer_get_glyph_infos(buf, &cnt);
+
+    /* Map shaped glyphs to input positions */
+    uint32_t glyph_ids[len];
+    memset(glyph_ids, 0,
+           len * sizeof(glyph_ids[0]));
+
+    if (cnt == (unsigned)len) {
+        for (unsigned i = 0; i < cnt; i++)
+            glyph_ids[i] = info[i].codepoint;
+    } else {
+        for (unsigned i = 0; i < cnt; i++) {
+            unsigned c = info[i].cluster;
+            if (c < (unsigned)len
+                && glyph_ids[c] == 0)
+            {
+                glyph_ids[c] =
+                    info[i].codepoint;
+            }
+        }
+    }
+
+    hb_buffer_destroy(buf);
+
+    /* Rasterize each glyph individually.
+     * Glyph ID 0 is .notdef (missing glyph) —
+     * fall back to codepoint-based rasterization
+     * which searches fallback fonts. */
+    size_t count = 0;
+    for (size_t i = 0; i < len; i++) {
+        if (glyph_ids[i] != 0) {
+            out[i] = fcft_rasterize_glyph_index(
+                _font, glyph_ids[i], subpixel);
+        } else {
+            /* Character missing from primary
+             * font — use codepoint path which
+             * searches fallback fonts */
+            out[i] = fcft_rasterize_char_utf32(
+                _font, text[i], subpixel);
+        }
+        if (out[i] != NULL)
+            count++;
+    }
+
+    return count;
+}
+
 static size_t
 grapheme_hash_index(const struct font_priv *font, size_t v)
 {
@@ -2579,6 +2737,16 @@ fcft_rasterize_grapheme_utf32(struct fcft_font *_font,
     return NULL;
 }
 
+FCFT_EXPORT size_t
+fcft_rasterize_shaped_run(
+    struct fcft_font *_font,
+    size_t len, const uint32_t text[static len],
+    enum fcft_subpixel subpixel,
+    const struct fcft_glyph *out[static len])
+{
+    return 0;
+}
+
 #endif
 
 #if defined(FCFT_HAVE_HARFBUZZ) && defined(FCFT_HAVE_UTF8PROC)
diff --git a/fcft/fcft.h b/fcft/fcft.h
index c8140f1..6743466 100644
--- a/fcft/fcft.h
+++ b/fcft/fcft.h
@@ -124,6 +124,25 @@ struct fcft_glyph {
 const struct fcft_glyph *fcft_rasterize_char_utf32(
     struct fcft_font *font, uint32_t cp, enum fcft_subpixel subpixel);
 
+/* Rasterize by FreeType glyph index (not codepoint).
+ * Use this when you have already shaped text with
+ * HarfBuzz and have the glyph IDs.  The returned
+ * glyph's .cp field is set to the glyph index ORed
+ * with 0x80000000.  Results are cached. */
+const struct fcft_glyph *fcft_rasterize_glyph_index(
+    struct fcft_font *font, uint32_t glyph_index,
+    enum fcft_subpixel subpixel);
+
+/* Shape a codepoint array with HarfBuzz and return
+ * one individually-cached glyph per input position.
+ * Returns the number of glyphs written to out[].
+ * Requires HarfBuzz support; returns 0 without it. */
+size_t fcft_rasterize_shaped_run(
+    struct fcft_font *font,
+    size_t len, const uint32_t text[static len],
+    enum fcft_subpixel subpixel,
+    const struct fcft_glyph *out[static len]);
+
 struct fcft_grapheme {
     int cols;  /* wcswidth(grapheme) */
 
