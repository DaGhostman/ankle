[wrap-git]
url = https://codeberg.org/dnkl/fcft.git
# Pinned, since the patches below are made against this revision
revision = 1ff7e79dabb22514fc27dcf1b61124c1e7bb7c62
depth = 1

# Applied in order:
#  0001: text-run glyphs are cached by glyph index, instead of being
#        re-rasterized on every call (needed for ligature performance)
#  0002: fcft PR #116, glyph-index and shaped-run rasterization APIs
#  0003+0004: fcft PR #118, COLRv1 color glyphs (rendered with pixman,
#        instead of rejecting COLRv1 fonts)
diff_files =
  fcft/0001-text-run-glyph-cache.patch,
  fcft/0002-glyph-index-and-shaped-run-apis.patch,
  fcft/0003-revert-reject-colrv1-fonts.patch,
  fcft/0004-colrv1-rendering.patch
