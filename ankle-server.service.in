[Service]
ExecStart=@bindir@/ankle --server=3
UnsetEnvironment=LISTEN_PID LISTEN_FDS LISTEN_FDNAMES
NonBlocking=true
# Logs go to syslog (the journal); don't log them twice via stderr
StandardOutput=null
StandardError=null

[Unit]
Requires=%N.socket
Description=Ankle terminal server mode
Documentation=man:ankle(1)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Install]
WantedBy=graphical-session.target
